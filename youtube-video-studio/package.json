{
  "name": "youtube-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Remotion template for assembling AI-generated YouTube videos",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Episode out/episode.mp4 --props=episodes/sample.json",
    "render:short": "remotion render Short out/short.mp4 --props=episodes/sample.json",
    "thumbnail": "remotion still Thumbnail out/thumbnail.png --props=episodes/sample.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
